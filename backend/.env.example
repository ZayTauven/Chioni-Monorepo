# Chioni backend — environment template (copy to .env and fill in real values)
SECRET_KEY=change-me
DEBUG=False

# PostgreSQL
DB_NAME=chioni_db
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Redis (Celery broker / result backend)
REDIS_URL=redis://localhost:6379/0

# Pont de Confiance — PSP & conversion EUR->KMF
# Backend PSP actif : "fake" (dev/tests) ou "stripe" (chantier dédié, clés requises).
# GARDE-FOU : "fake" est refusé au démarrage si DEBUG=False (ImproperlyConfigured).
PSP_BACKEND=fake
# OBLIGATOIRE et non vide (comme SECRET_KEY) : signe les webhooks de paiement.
PSP_WEBHOOK_SECRET=change-me
# Taux EUR->KMF servi par la source fixe de dev (KMF arrimé à l'euro)
FX_EUR_KMF_RATE=491.9678
# Frais explicites (en % du montant EUR net), payés en sus par le tuteur
PSP_FEE_PERCENT=2.50

# SMS (auth OTP + notifications)
# Backend actif : "console" (dev : loggue, n'envoie rien), "memory" (tests),
# "stub" (squelette des agrégateurs comoriens — chantier dédié).
# GARDE-FOU : "console" et "memory" sont refusés au démarrage si DEBUG=False.
SMS_BACKEND=console

# Throttling OTP (surchargeable) — le SMS coûte de l'argent et peut harceler.
# THROTTLE_OTP_REQUEST_PHONE=3/hour
# THROTTLE_OTP_REQUEST_IP=10/hour
# THROTTLE_OTP_VERIFY_IP=10/hour

# Celery : exécution inline (sans broker) — par défaut suit DEBUG.
# CELERY_TASK_ALWAYS_EAGER=True
